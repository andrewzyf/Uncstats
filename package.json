{
  "name": "uncstats",
  "version": "1.0.0",
  "private": true,
  "description": "UncStats — Unemployed Uncle Statistics. Terminal Instagram Reels doomscrolling audit.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "web": "npm run dev --workspace=apps/web",
    "web:build": "npm run build --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
